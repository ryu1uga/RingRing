<Window x:Class="RingRing.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RingRing"
        Width="760" Height="640" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/ringring.ico"
        Background="#ECEEF2"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A4250" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4A5260" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#15181D" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="#2348F0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Encabezado -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="24,18">
            <DockPanel>
                <Image Source="pack://application:,,,/Assets/logo-256.png" Width="52" Height="52"
                       DockPanel.Dock="Left" Margin="0,0,16,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TestButton" Content="Probar llamada" Margin="0,0,8,0" />
                    <Button x:Name="QrButton" Content="Mostrar QR" Style="{StaticResource Primary}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RingRing" FontSize="22" FontWeight="Bold" Foreground="#15181D" />
                    <TextBlock x:Name="StatusText" Text="Iniciando..." Foreground="#3A4250" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pie -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RevertButton" Content="Descartar cambios" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="Guardar" Style="{StaticResource Primary}" />
                </StackPanel>
                <TextBlock x:Name="SaveMessage" VerticalAlignment="Center" Foreground="#B3263E" TextWrapping="Wrap"
                           Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <TabControl Margin="16" Padding="20,12">
            <!-- General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Cómo te ven" Style="{StaticResource Section}" />
                        <TextBlock Text="Nombre que aparece en la página" Style="{StaticResource Label}" />
                        <TextBox x:Name="DisplayNameBox" MaxLength="40" />
                        <TextBlock Text="Se muestra como &quot;Llamar a ...&quot;." Style="{StaticResource Hint}" />

                        <TextBlock Text="Red" Style="{StaticResource Section}" Margin="0,20,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Puerto" Style="{StaticResource Label}" />
                                <TextBox x:Name="PortBox" MaxLength="5" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PIN (opcional)" Style="{StaticResource Label}" />
                                <TextBox x:Name="PinBox" MaxLength="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Espera entre llamadas (s)" Style="{StaticResource Label}" />
                                <TextBox x:Name="CooldownBox" MaxLength="3" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Si cambias el puerto, actualiza también la regla del Firewall de Windows (el instalador crea la del 7777)." />

                        <TextBlock Text="Inicio" Style="{StaticResource Section}" Margin="0,20,0,4" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="Iniciar RingRing al encender la PC" />
                        <CheckBox x:Name="StartMinimizedBox" Content="Iniciar minimizado en la bandeja" />
                        <CheckBox x:Name="CloseToTrayBox" Content="Al cerrar la ventana, seguir en la bandeja" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Alertas -->
            <TabItem Header="Alertas">
                <StackPanel>
                    <TextBlock Text="Qué pasa cuando te llaman" Style="{StaticResource Section}" />
                    <CheckBox x:Name="ToastBox" Content="Notificación de Windows con botones de respuesta" />
                    <CheckBox x:Name="OverlayBox" Content="Aviso a pantalla completa que parpadea" />
                    <CheckBox x:Name="SoundBox" Content="Sonido (configúralo en la pestaña Sonido)" />
                    <CheckBox x:Name="FlashBox" Content="Parpadeo del ícono en la bandeja" />
                    <CheckBox x:Name="PauseMediaBox" Content="Pausar la música mientras suena y reanudarla al responder" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="La pausa usa los controles multimedia de Windows, así que funciona con Spotify, YouTube Music en el navegador y la mayoría de reproductores." />
                </StackPanel>
            </TabItem>

            <!-- Sonido -->
            <TabItem Header="Sonido">
                <StackPanel>
                    <TextBlock Text="Tono" Style="{StaticResource Section}" />
                    <ComboBox x:Name="SoundCombo" DisplayMemberPath="Name" SelectedValuePath="Id" MinHeight="32" />

                    <StackPanel x:Name="CustomPanel" Margin="0,8,0,0">
                        <TextBlock Text="Archivo propio" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Button x:Name="BrowseButton" Content="Elegir..." DockPanel.Dock="Right" Margin="8,0,0,0" />
                            <TextBox x:Name="CustomPathBox" IsReadOnly="True" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="Volumen" Style="{StaticResource Label}" />
                    <DockPanel>
                        <TextBlock x:Name="VolumeLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Repeticiones por llamada" Style="{StaticResource Label}" />
                    <ComboBox x:Name="RepeatCombo" Width="120" HorizontalAlignment="Left" MinHeight="32" />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="PlayButton" Content="Escuchar" Margin="0,0,8,0" />
                        <Button x:Name="StopButton" Content="Detener" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                               Text="Suena por la salida de audio predeterminada, es decir, por tus audífonos si están activos." />
                </StackPanel>
            </TabItem>

            <!-- Respuestas -->
            <TabItem Header="Respuestas">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Respuestas rápidas" Style="{StaticResource Section}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Aparecen como botones en el aviso y en la notificación (la notificación muestra las 4 primeras). Para el atajo, haz clic en la celda y presiona la combinación de teclas." />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <CheckBox x:Name="HotkeysEnabledBox" Content="Activar atajos globales" Margin="0,12,0,0" />
                        <TextBlock Text="Atajo para solo marcar visto" Style="{StaticResource Label}" />
                        <TextBox x:Name="SeenHotkeyBox" Width="200" HorizontalAlignment="Left"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" IsReadOnlyCaretVisible="True" />
                    </StackPanel>

                    <DataGrid x:Name="RepliesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                              CanUserDeleteRows="True" HeadersVisibility="Column" Margin="0,12,0,0"
                              GridLinesVisibility="Horizontal" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Texto" Width="*" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Header="Atajo" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Hotkey}" VerticalAlignment="Center" Margin="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Historial -->
            <TabItem Header="Historial">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Últimas llamadas" Style="{StaticResource Section}" />
                    <ListView x:Name="HistoryList" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Hora" Width="70" DisplayMemberBinding="{Binding CreatedAt, StringFormat=HH:mm}" />
                                <GridViewColumn Header="Quién" Width="120" DisplayMemberBinding="{Binding DisplayCaller}" />
                                <GridViewColumn Header="Mensaje" Width="200" DisplayMemberBinding="{Binding Message}" />
                                <GridViewColumn Header="IP" Width="110" DisplayMemberBinding="{Binding RemoteIp}" />
                                <GridViewColumn Header="Estado" Width="170" DisplayMemberBinding="{Binding StatusText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
