<Window x:Class="RingRing.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RingRing: te llaman"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <Style x:Key="ReplyButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#15181D" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDE4FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#15181D" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fondo que pulsa -->
        <Border x:Name="Pulse" Background="#2348F0" Opacity="0.82">
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.82" To="0.55"
                                             Duration="0:0:0.6" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
            <Viewbox Width="140" Height="140" HorizontalAlignment="Center">
                <Canvas Width="128" Height="128" RenderTransformOrigin="0.5,0.25">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="BellSwing" Angle="0" />
                    </Canvas.RenderTransform>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="BellSwing" Storyboard.TargetProperty="Angle"
                                                     From="-14" To="14" Duration="0:0:0.35" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>
                    <Path Data="M40,84 V62 A24,24 0 0 1 88,62 V84 Z" Stroke="White" StrokeThickness="7"
                          StrokeLineJoin="Round" />
                    <Path Data="M32,84 H96" Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <Path Data="M56,94 A8,8 0 0 0 72,94" Stroke="White" StrokeThickness="7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M64,38 V30" Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>

            <TextBlock x:Name="CallerText" Text="Alguien te está llamando" Foreground="White" FontSize="48"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0" />
            <TextBlock x:Name="MessageText" Foreground="White" FontSize="24" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.95" />
            <TextBlock x:Name="ExtraText" Foreground="White" FontSize="16" TextAlignment="Center"
                       Margin="0,8,0,0" Opacity="0.85" />

            <WrapPanel x:Name="ReplyPanel" HorizontalAlignment="Center" Margin="0,36,0,0" />

            <Button x:Name="SeenButton" Content="Solo marcar visto" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Style="{StaticResource ReplyButton}" Background="#33FFFFFF" Foreground="White"
                    FontSize="16" MinHeight="44" />

            <TextBlock x:Name="HintText" Foreground="White" FontSize="14" TextAlignment="Center"
                       Margin="0,24,0,0" Opacity="0.85" />
        </StackPanel>
    </Grid>
</Window>
